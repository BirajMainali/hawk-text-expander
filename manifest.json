{
  "manifest_version": 3,
  "name": "Promptly",
  "version": "1.0",
  "description": "A Simple Text Expander - Variables and Shortcuts",
  "author": "Biraj Mainali",
  "action": {
    "default_popup": "./ui/index.html",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "./scripts/store.js",
        "./scripts/site.js"
      ]
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "*.js",
        "*.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}